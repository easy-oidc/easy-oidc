# Easy OIDC Local Development Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control! (it's in gitignore FWIW)

# Ed25519 signing key (PEM format)
# Generate with: scripts/generate-ed25519-key.sh
export EASYOIDC_SIGNING_KEY='-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIFYOURxCMy8dPaRvPHtVMr0qH9FeX9QJR5KHLHmYxZI8
-----END PRIVATE KEY-----'

# Each connector secret is one JSON environment variable. Connector IDs can
# share a type, but must use independent credentials.
export EASYOIDC_GOOGLE_CREDENTIALS='{"client_id":"your-client-id","client_secret":"your-client-secret"}'

# Generic encryption master key used to derive purpose-specific keys. It is
# required for GitHub identity selection and non-email refresh sessions.
# Generate with: openssl rand -hex 32
export EASYOIDC_ENCRYPTION_KEY='replace-with-64-hex-characters'

# Required when email verification is configured. Use at least 32 random bytes.
export EASYOIDC_OTP_SECRET='replace-with-a-long-random-secret'

# Optional authenticated SMTP credentials used by examples/config/config-multiple.jsonc.
export EASYOIDC_SMTP_CREDENTIALS='{"username":"easy-oidc","password":"easy-oidc"}'
export EASYOIDC_TURNSTILE_SECRET='replace-with-your-turnstile-secret'

# Policy database development connection. Remote deployments must use strict TLS (prefer verify-full).
export EASYOIDC_POLICY_DB_URL='postgresql://easy_oidc_policy:password@localhost:5432/application?sslmode=disable'
