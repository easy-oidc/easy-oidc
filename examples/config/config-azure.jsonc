{
  "$schema": "https://easy-oidc.dev/schema/v2/config.schema.json",

  // Azure Key Vault configuration example
  "issuer_url": "https://auth.example.com",
  "http_listen_addr": "127.0.0.1:8080",
  "signing_algorithm": "RS256",

  // Secrets configuration for Azure Key Vault
  "secrets": {
    "provider": "azure",
    "signing_key_name": "easy-oidc-signing-key",
    "azure_keyvault_url": "https://my-vault.vault.azure.net/",
  },

  "state_database": {
    "driver": "sqlite",
    "path": "/var/lib/easy-oidc/easy-oidc-state.db",
  },

  // Upstream connector
  "user_login_connectors": {
    "google": {
      "type": "google",
      "display_name": "Google",
      "credentials_secret": "easy-oidc-google-credentials",
      "scopes": ["openid", "email", "profile"],

      // Optional: hint a Google Workspace domain in Google's account chooser
      "google": {
        "hd": "example.com",
      },
    },
  },

  "static_policy": {
    // Default redirect URIs
    "default_redirect_uris": ["http://localhost:8000"],

    // User group mappings (email → groups)
    "user_group_mappings": {
      "prod-groups": {
        "alice@example.com": ["prod-admins", "devs"],
        "bob@example.com": ["prod-readonly"],
      },
    },

    // OIDC clients
    "clients": {
      "kubelogin-prod": {
        "redirect_uris": ["http://localhost:8000"],
        "user_group_mapping": "prod-groups",
      },
    },
  },

  // Optional: Token TTL in seconds (default: 3600 = 1 hour)
  // "access_token_ttl": "15m",
  // "id_token_ttl": "15m",
}
