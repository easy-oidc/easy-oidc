{
  "$schema": "https://easy-oidc.dev/schema/v2/config.schema.json",

  // Local development configuration
  // Secrets are loaded from environment variables (see .env.example)
  "issuer_url": "http://localhost:8080",
  "http_listen_addr": "127.0.0.1:8080",
  "signing_algorithm": "RS256",

  // Require users to have groups assigned (default: true)
  // Set to false to allow authentication without groups
  "require_groups": true,

  "secrets": {
    "provider": "env",
    "signing_key_name": "EASYOIDC_SIGNING_KEY",
  },

  "state_database": { "driver": "sqlite", "path": "temp/easy-oidc-state.db" },

  "connectors": {
    "google": {
      "type": "google",
      "display_name": "Google",
      "order": 10,
      "credentials_secret": "EASYOIDC_GOOGLE_CREDENTIALS",
      "scopes": ["openid", "email", "profile"],
    },
  },

  "default_redirect_uris": ["http://localhost:8000"],

  "groups_overrides": {
    "local-groups": {
      "your-email@example.com": ["admins", "developers"],
    },
  },

  "clients": {
    "kubelogin-local": {
      "groups_override": "local-groups",
      // Optional: override require_groups per-client
      // "require_groups": false
    },
  },
}
