// SPDX-License-Identifier: Apache-2.0

{
  "issuer_url": "http://127.0.0.1:18080",
  "http_listen_addr": "127.0.0.1:18080",
  "signing_algorithm": "RS256",
  "access_token_ttl": "5s",
  "id_token_ttl": "5s",

  "secrets": {
    "provider": "env",
    "signing_key_name": "EASYOIDC_SIGNING_KEY",
    "encryption_key_name": "EASYOIDC_ENCRYPTION_KEY",
  },

  "state_database": {
    "driver": "postgresql",
    "connection_string_secret": "EASYOIDC_STATE_DB_URL",
    "migrations": { "connection_string_secret": "EASYOIDC_STATE_MIGRATION_DB_URL" },
  },

  "policy_database": {
    // The policy database supplies the db-* clients after the static flows.
    "driver": "postgresql",
    "connection_string_secret": "EASYOIDC_POLICY_DB_URL",
    "redirect_uris": ["http://localhost:18000"],
    "client_defaults": {
      "require_user_groups_from_policy": true,
      "refresh_tokens": { "enabled": true },
    },
  },

  "user_login_connectors": {
    "generic": {
      "type": "generic",
      "display_name": "E2E Dex",
      "credentials_secret": "EASYOIDC_DEX_CREDENTIALS",
      "scopes": ["openid", "email", "profile", "groups"],

      "generic": {
        "authorization_url": "http://127.0.0.1:5556/dex/auth",
        "token_url": "http://127.0.0.1:5556/dex/token",
        "userinfo_url": "http://127.0.0.1:5556/dex/userinfo",
        "subject_field": "sub",
        "email_field": "email",
        "email_verified_field": "email_verified",
        "refresh": {
          "scopes": ["offline_access"],
        },
      },
    },
  },

  "service_token_issuers": {
    "dex": {
      "provider": "oidc",
      "issuer_url": "http://127.0.0.1:5556/dex",
      "signing_algs": ["RS256"],
      "max_token_age": "5m",
    },
  },

  "static_policy": {
    "trust_policies": {
      "dex-static-e2e": {
        "issuer": "dex",
        "required_claims": {
          "sub": { "const": "CiQwOGE4Njg0Yi1kYjg4LTRiNzMtOTBhOS0zY2QxNjYxZjU0NjYSBWxvY2Fs" },
        },
      },
    },
    "default_redirect_uris": ["http://localhost:18000"],

    "user_group_mappings": {
      "static-groups": {
        // Dex's mockCallback connector returns this fixed, non-configurable identity.
        "kilgore@kilgore.trout": ["static-admins", "static-developers"],
      },
    },

    "clients": {
      "static-ci-token-exchange-e2e": {
        "trust_bindings": [{
          "id": "dex-static-exchange-e2e",
          "trust_policy": "dex-static-e2e",
          "subject": "trusted:e2e:static",
          "groups": ["e2e:static"],
        }],
      },
      "static-kubelogin-interactive-e2e": {
        "user_group_mapping": "static-groups",
        "refresh_tokens": {
          "enabled": true,
        },
      },
    },
  },
}
